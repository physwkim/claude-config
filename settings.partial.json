{
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(cargo check:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(cargo generate-lockfile:*)",
      "Read",
      "Grep",
      "Glob",
      "Agent",
      "WebSearch",
      "WebFetch",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(eza:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sed -n:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(tokei:*)",
      "Bash(which:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git grep:*)",
      "Bash(git rev-parse:*)",
      "Bash(cargo:*)",
      "Bash(python3:*)",
      "Bash(rm -rf /tmp/claude-{{UID}}/*)",
      "Bash(rm -f /tmp/claude-{{UID}}/*)",
      "Bash(rm -r /tmp/claude-{{UID}}/*)",
      "Bash(rm /tmp/claude-{{UID}}/*)",
      "Bash(mkdir -p /tmp/claude-{{UID}}/*)",
      "Bash(mkdir /tmp/claude-{{UID}}/*)",
      "Bash(rm -rf {{HOME}}/work/_tgt/*)",
      "Bash(rm -f {{HOME}}/work/_tgt/*)",
      "Bash(rm -r {{HOME}}/work/_tgt/*)",
      "Bash(rm {{HOME}}/work/_tgt/*)",
      "Bash(mkdir -p {{HOME}}/work/_tgt/*)",
      "Bash(mkdir {{HOME}}/work/_tgt/*)"
    ]
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "effortLevel": "xhigh",
  "autoUpdatesChannel": "latest",
  "skipDangerousModePermissionPrompt": true,
  "disableRemoteControl": true,
  "autoCompactEnabled": true,
  "autoCompactWindow": 200000,
  "attribution": {
    "commit": "",
    "pr": ""
  }
}
